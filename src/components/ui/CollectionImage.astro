---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> {
  src: string;
  image?: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  widths?: number[];
}
const { src, image, widths = [160, 320, 480, 600], loading = 'lazy', decoding = 'async', sizes = 'auto, 240px', ...attributes } = Astro.props;
const maxWidth = image ? Math.min(image.width, Math.max(...widths)) : 0;
const candidates = image ? [...new Set([...widths.filter(width => width <= maxWidth), maxWidth])].sort((a, b) => a - b) : [];
const fallbackWidth = Math.min(maxWidth, 480);
---
{image ? <Image src={image} {...attributes} width={fallbackWidth} height={Math.round(image.height * fallbackWidth / image.width)} widths={candidates} sizes={sizes} loading={loading} decoding={decoding} format="webp" quality={80} layout="none" /> : <img src={src} {...attributes} loading={loading} decoding={decoding} />}
