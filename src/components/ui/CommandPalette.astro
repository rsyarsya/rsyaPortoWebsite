---
import Icon from './Icon.astro';
import { profile } from '../../data/profile';

// Commands are plain data: a link (href/target), the contact dialog, or a preference value.
const isHome = Astro.url.pathname === '/';
const section = (id: string) => (isHome ? `#${id}` : `/#${id}`);
interface Command { label: string; hint: string; keywords: string; href?: string; target?: string; action?: 'contact'; pref?: 'theme' | 'motion' | 'language'; value?: string; }
const commands: Command[] = [
  { label: 'Go to Home', hint: 'Section', keywords: 'intro top start hero', href: section('intro') },
  { label: 'Go to Work', hint: 'Section', keywords: 'projects selected portfolio', href: section('projects') },
  { label: 'Go to Activity', hint: 'Section', keywords: 'contributions github', href: section('contributions') },
  { label: 'Go to Off the Clock', hint: 'Section', keywords: 'gallery games books photos travel hobbies', href: section('off-the-clock') },
  { label: 'Go to Contact', hint: 'Section', keywords: 'email reach', href: section('contact') },
  { label: 'Open guestbook', hint: 'Page', keywords: 'notes sign', href: '/guestbook/' },
  { label: 'Open playground', hint: 'Page', keywords: 'experiment water ripple waves', href: '/playground/' },
  { label: 'Send me a message', hint: 'Contact', keywords: 'contact email message get in touch', action: 'contact', href: '/#contact' },
  { label: 'Open résumé', hint: 'PDF, new tab', keywords: 'resume cv pdf', href: profile.resume, target: '_blank' },
  { label: 'Theme: Light', hint: 'Theme', keywords: 'appearance mode color', pref: 'theme', value: 'light' },
  { label: 'Theme: Dark', hint: 'Theme', keywords: 'appearance mode color night', pref: 'theme', value: 'dark' },
  { label: 'Animation: System', hint: 'Animation', keywords: 'motion reduced default', pref: 'motion', value: 'system' },
  { label: 'Animation: On', hint: 'Animation', keywords: 'motion enable', pref: 'motion', value: 'on' },
  { label: 'Animation: Off', hint: 'Animation', keywords: 'motion disable reduce', pref: 'motion', value: 'off' },
  { label: 'Language: English', hint: 'Language', keywords: 'bahasa translate english', pref: 'language', value: 'en' },
  { label: 'Language: Indonesia', hint: 'Language', keywords: 'bahasa terjemahan indonesia', pref: 'language', value: 'id' },
];
---
<dialog id="command-palette" class="palette" aria-label="Command palette">
  <div class="palette-inner">
    <div class="palette-search">
      <Icon name="search" />
      <input id="palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" aria-label="Search commands" placeholder="Search commands…" autocomplete="off" spellcheck="false" />
      <button type="button" class="palette-x" data-palette-close aria-label="Close"><Icon name="close" /></button>
    </div>
    <ul id="palette-list" role="listbox" aria-label="Commands" data-lenis-prevent>
      {commands.map((command, index) => (
        <li id={`palette-option-${index}`} role="option" aria-selected="false" data-keywords={`${command.label} ${command.keywords}`.toLowerCase()} data-href={command.href} data-target={command.target} data-action={command.action} data-pref={command.pref} data-value={command.value} data-hint={command.hint}>
          <span class="label">{command.label}</span><span class="hint">{command.hint}</span>
        </li>
      ))}
    </ul>
    <p class="palette-empty" role="status"></p>
  </div>
</dialog>
<script>
  import { lockScroll, unlockScroll } from '../../scripts/smooth-scroll';
  import { setLanguage, setMotion, setTheme } from '../../scripts/preferences';

  const dialog = document.querySelector<HTMLDialogElement>('#command-palette');
  if (dialog && typeof dialog.showModal === 'function') setup(dialog);

  function setup(dialog: HTMLDialogElement) {
    const root = document.documentElement;
    const input = dialog.querySelector<HTMLInputElement>('#palette-input')!;
    const list = dialog.querySelector<HTMLUListElement>('#palette-list')!;
    const empty = dialog.querySelector<HTMLElement>('.palette-empty')!;
    const options = [...list.querySelectorAll<HTMLLIElement>('[role="option"]')];
    let visible = options;
    let active = -1;
    let locked = false;
    let returnTo: HTMLElement | null = null;

    function setActive(index: number) {
      options.forEach(option => option.setAttribute('aria-selected', 'false'));
      active = visible.length ? (index + visible.length) % visible.length : -1;
      const option = visible[active];
      if (option) {
        option.setAttribute('aria-selected', 'true');
        input.setAttribute('aria-activedescendant', option.id);
        option.scrollIntoView({ block: 'nearest' });
      } else input.removeAttribute('aria-activedescendant');
    }

    // Every typed word must appear in the label or keywords.
    function filter() {
      const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      visible = options.filter(option => {
        const keywords = `${option.dataset.keywords} ${option.querySelector('.label')?.textContent}`.toLowerCase();
        const match = terms.every(term => keywords.includes(term));
        option.hidden = !match;
        return match;
      });
      list.hidden = !visible.length;
      input.setAttribute('aria-expanded', String(visible.length > 0));
      empty.textContent = visible.length ? '' : `No commands match “${input.value.trim()}”.`;
      setActive(0);
    }

    // The current theme and animation values are marked so the palette agrees with the settings menu.
    function markCurrent() {
      for (const option of options) {
        const { pref, value, hint } = option.dataset;
        const current = (pref === 'theme' && root.dataset.theme === value) || (pref === 'motion' && root.dataset.motionSetting === value) || (pref === 'language' && root.dataset.language === value);
        option.querySelector('.hint')!.textContent = current ? 'Current' : hint!;
      }
    }

    function open(trigger: HTMLElement | null) {
      if (dialog.open) return;
      returnTo = trigger;
      input.value = '';
      markCurrent();
      filter();
      dialog.showModal();
      lockScroll();
      locked = true;
      input.focus();
    }

    // Cleanup runs synchronously, so a following command (contact dialog, navigation) starts after the unlock.
    function close(restoreFocus = true) {
      if (dialog.open) dialog.close();
      if (!locked) return;
      locked = false;
      unlockScroll();
      if (restoreFocus) returnTo?.focus({ preventScroll: true });
      returnTo = null;
    }
    dialog.addEventListener('close', () => close());

    function followLink(href: string, target?: string) {
      const link = document.createElement('a');
      link.href = href;
      if (target) {
        link.target = target;
        link.rel = 'noopener noreferrer';
      }
      document.body.append(link);
      // A real click lets smooth-scroll.ts handle same-page hashes (Lenis, history, focus).
      link.click();
      link.remove();
      if (href.startsWith('#')) {
        const section = document.querySelector<HTMLElement>(href);
        if (section && document.activeElement !== section) {
          if (!section.hasAttribute('tabindex')) section.setAttribute('tabindex', '-1');
          section.focus({ preventScroll: true });
        }
      }
    }

    function run(option: HTMLLIElement | undefined) {
      if (!option) return;
      const { href, target, action, pref, value } = option.dataset;
      const opener = returnTo;
      if (action === 'contact' && document.querySelector('#contact-dialog')) {
        close(false);
        document.dispatchEvent(new CustomEvent('contact:open', { detail: { returnTo: opener ?? undefined } }));
        return;
      }
      if (pref) {
        close();
        if (pref === 'theme') setTheme(value as 'light' | 'dark');
        else if (pref === 'language') setLanguage(value as 'en' | 'id');
        else setMotion(value as 'system' | 'on' | 'off');
        return;
      }
      // Same-page sections take focus themselves; everything else returns focus to the opener first.
      close(!href?.startsWith('#'));
      if (href) followLink(href, target);
    }

    input.addEventListener('input', filter);
    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') setActive(active + (event.key === 'ArrowDown' ? 1 : -1));
      else if (event.key === 'Home' || event.key === 'End') setActive(event.key === 'Home' ? 0 : visible.length - 1);
      else if (event.key === 'Enter') run(visible[active]);
      else return;
      event.preventDefault();
    });
    list.addEventListener('pointermove', event => {
      const option = (event.target as Element).closest<HTMLLIElement>('[role="option"]');
      if (option && option !== visible[active]) setActive(visible.indexOf(option));
    });
    list.addEventListener('click', event => run((event.target as Element).closest<HTMLLIElement>('[role="option"]') ?? undefined));
    // Clicks on the backdrop (the dialog box itself, outside the inner panel) close the palette.
    dialog.addEventListener('click', event => { if (event.target === dialog) close(); });
    dialog.querySelector('[data-palette-close]')!.addEventListener('click', () => close());

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-palette-open]')) {
      button.hidden = false;
      button.addEventListener('click', () => open(button));
    }

    document.addEventListener('keydown', event => {
      if (event.key.toLowerCase() !== 'k' || !(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey) return;
      if (dialog.open) {
        event.preventDefault();
        close();
        return;
      }
      const target = event.target as HTMLElement;
      if (document.querySelector('dialog[open]') || target.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
      event.preventDefault();
      open(document.activeElement instanceof HTMLElement ? document.activeElement : null);
    });
  }
</script>
<style>
  [hidden] { display: none !important; }
  .palette {
    width: min(560px, calc(100vw - 32px));
    max-width: none;
    max-height: min(480px, calc(100dvh - 32px));
    margin: min(12vh, 96px) auto auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }
  .palette[open] { display: flex; }
  .palette::backdrop { background: rgb(41 40 36 / 45%); }
  :global([data-theme='dark']) .palette::backdrop { background: rgb(0 0 0 / 55%); }
  .palette-inner { display: flex; flex-direction: column; width: 100%; min-height: 0; }
  .palette-search { display: flex; align-items: center; gap: 10px; padding: 6px 6px 6px 16px; border-bottom: 1px solid var(--color-border); color: var(--color-muted); }
  .palette-search :global(svg) { flex: none; }
  input { flex: 1; min-width: 0; min-height: 44px; border: 0; background: transparent; color: var(--color-text); font: 17px/1.5 var(--font-sans); }
  /* The listbox shows the active option, so the field itself needs no ring while typing. */
  input:focus-visible { outline: none; }
  .palette-search:has(input:focus-visible) { box-shadow: inset 0 -2px 0 var(--color-focus); }
  .palette-x { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 44px; height: 44px; border: 0; border-radius: 8px; background: transparent; color: var(--color-muted); cursor: pointer; }
  .palette-x:hover { background: var(--color-surface); color: var(--color-text); }
  ul { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 6px; }
  li { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 16px; }
  li[aria-selected='true'] { background: var(--color-surface-hover); }
  .hint { flex: none; font-size: 14px; color: var(--color-muted); }
  .palette-empty:empty { display: none; }
  .palette-empty { padding: 20px 16px; color: var(--color-muted); font-size: 15px; overflow-wrap: anywhere; }
  :global(:root[data-motion='full']) .palette[open] { animation: palette-in 160ms ease-out; }
  :global(:root[data-motion='full']) .palette[open]::backdrop { animation: palette-backdrop-in 160ms ease-out; }
  @keyframes palette-in { from { opacity: 0; transform: translateY(-6px); } }
  @keyframes palette-backdrop-in { from { opacity: 0; } }
</style>
