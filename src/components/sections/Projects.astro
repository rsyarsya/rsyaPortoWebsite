---
import SectionHeading from '../ui/SectionHeading.astro';
import { projects } from '../../data/portfolio';
---
<section id="projects" aria-labelledby="projects-title">
  <SectionHeading id="projects-title" title="Selected projects" />
  <p class="section-description">A selection of work across connected systems, AI, simulation, and cloud.</p>
  <ul class="placeholder-list">
    {projects.map(project => <li class="project-row">
      <div class="project-heading"><h3>{project.name}</h3><span class="metadata">{project.role}</span></div>
      <p>{project.description}</p>
      <div class="project-meta"><span>{project.context}</span><ul aria-label={`${project.name} technologies`}>{project.technologies.map(technology => <li>{technology}</li>)}</ul></div>
    </li>)}
  </ul>
</section>
<style>
  .project-row { padding-block: 22px; border-bottom: 1px solid var(--color-border); }
  .project-heading { display: flex; justify-content: space-between; gap: 8px 24px; align-items: baseline; }
  h3 { font-family: var(--font-serif); font-size: 21px; font-weight: 500; }
  .project-heading .metadata { flex-shrink: 0; }
  .project-row > p { margin-top: 6px; color: var(--color-muted); }
  .project-meta { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; margin-top: 14px; font-size: 13px; color: var(--color-muted); }
  .project-meta ul { display: flex; flex-wrap: wrap; gap: 6px; }
  .project-meta li { border: 1px solid var(--color-border); border-radius: 5px; padding: 1px 7px; }
  @media (max-width: 767px) { .project-heading { flex-direction: column; gap: 2px; } }
</style>
