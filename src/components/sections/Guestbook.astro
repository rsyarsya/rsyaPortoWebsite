---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
---
<section id="guestbook" aria-labelledby="guestbook-title">
  <SectionHeading id="guestbook-title" title="Guestbook" />
  <div class="invitation">
    <div><Icon name="guestbook" /><p>Leave a note or say hello.</p></div>
    <a href="/guestbook/">Visit the guestbook<Icon name="arrow-up-right" /></a>
  </div>
</section>
<style>
  .invitation { border-block: 1px solid var(--color-border); padding-block: 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .invitation > div > :global(svg) { color: var(--color-muted); margin-bottom: 10px; }
  p { max-width: 38ch; }
  a { display: inline-flex; flex-shrink: 0; align-items: center; gap: 6px; min-height: 44px; font-size: 15px; }
  @media (max-width: 540px) { .invitation { flex-direction: column; align-items: flex-start; gap: 16px; } }
</style>
