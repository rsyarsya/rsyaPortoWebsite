<div class="ascii-background" data-ascii-background aria-hidden="true"><canvas></canvas><canvas></canvas></div>
<script>
  import '../../scripts/ascii-background';
</script>
<style>
  /* z-index 1: above the in-flow content (the strips never overlap it), below ScrollEdges (25) and the header (40).
