---
import PortfolioLink from '../ui/PortfolioLink.astro';
import { profile } from '../../data/profile';
const homeLink = (hash: string) => Astro.url.pathname === '/' ? hash : `/${hash}`;
const groups = [
  { title: 'This site', links: [{ label: 'Home', href: homeLink('#intro') }, { label: 'Work', href: homeLink('#projects') }, { label: 'Activity', href: homeLink('#contributions') }, { label: 'Guestbook', href: '/guestbook/' }, { label: 'Playground', href: '/playground/' }] },
  { title: 'Resources', links: [{ label: 'Résumé', href: profile.resume }, { label: 'Source code', href: profile.source }] },
  { title: 'Connect', links: [{ label: 'Email', href: `mailto:${profile.email}` }, { label: 'GitHub', href: profile.github }, { label: 'LinkedIn', href: profile.linkedin }, { label: 'Credly', href: profile.credly }] },
];
---
<footer>
  <div class="footer-top">
    <div class="signature"><span>Portfolio</span><span class="metadata">Data, AI, cloud &amp; IoT.</span></div>
    <!-- Static (no-JS) state is neutral; src/scripts/now-playing.ts fills in real Spotify data. -->
    <div class="listening" role="group" aria-label="Listening activity" data-now-playing data-state="static">
      <div class="album" data-np-art><span class="disc" aria-hidden="true"></span></div>
      <div class="np-text">
        <span class="metadata np-line" data-np-label>Music</span>
        <p class="np-line" data-np-title>Listening activity</p>
        <span class="metadata np-line" data-np-sub>Shown when JavaScript is on</span>
      </div>
    </div>
  </div>
  <div class="groups">
    {groups.map(group => <div><h2>{group.title}</h2><ul>{group.links.map(link => <li><PortfolioLink {...link} /></li>)}</ul></div>)}
  </div>
  <p class="footer-note">© 2026. Built with Astro.</p>
</footer>
<script>
  import '../../scripts/now-playing';
</script>
<style>
  footer { border-top: 1px solid var(--color-border); padding-block: 40px 32px; }
  .footer-top { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; margin-bottom: 40px; }
  .signature { display: flex; flex-direction: column; gap: 2px; }
  .signature > span:first-child { font-weight: 600; }
  /* Fixed width and single-line rows keep the widget's box constant across states (no layout shift). */
  .listening { display: flex; align-items: center; gap: 12px; width: 300px; max-width: 100%; font-size: 15px; line-height: 1.35; }
  .listening .metadata { font-size: 13px; }
  .listening p { margin-block: 2px; }
  .np-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .np-line { display: block; min-height: 1.35em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .np-line :global(a) { text-decoration: none; }
  .np-line :global(a:hover) { text-decoration: underline; }
  /* Rows and the artwork box clip overflow, so keep the focus ring inside them. */
  .np-line :global(a:focus-visible), .album :global(a:focus-visible) { outline-offset: -2px; }
  [data-state='loading'] .np-line:empty::before { content: ''; display: inline-block; vertical-align: middle; width: 70%; height: 0.75em; border-radius: 4px; background: var(--color-surface); }
  [data-state='loading'] .np-line[data-np-sub]:empty::before { width: 45%; }
  .album { flex-shrink: 0; display: grid; place-items: center; width: 52px; height: 52px; box-sizing: border-box; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); overflow: hidden; }
  .album :global(.np-art-link) { display: grid; place-items: center; width: 100%; height: 100%; }
  .album :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .album :global(.disc) { width: 28px; aspect-ratio: 1; border: 1px solid var(--color-border); border-radius: 50%; position: relative; }
  .album :global(.disc)::after { content: ''; position: absolute; inset: 10px; border: 1px solid var(--color-border); border-radius: 50%; }
  .album:has(img) { border-radius: 4px; }
  .groups { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 16px; }
  h2 { font-family: var(--font-sans); font-size: 14px; font-weight: 400; letter-spacing: 0; color: var(--color-muted); margin-bottom: 8px; }
  li { display: flex; align-items: center; min-height: 44px; }
  li :global(a) { text-decoration: none; }
  li :global(a:hover) { text-decoration: underline; }
  .footer-note { margin-top: 32px; font-size: 13px; color: var(--color-muted); }
  @media (max-width: 767px) {
    .footer-top { flex-direction: column; gap: 24px; margin-bottom: 32px; }
    .groups { font-size: 15px; gap: 12px; }
    footer { padding-top: 32px; }
  }
</style>
