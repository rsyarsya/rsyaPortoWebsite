---
import PortfolioLink from '../ui/PortfolioLink.astro';
import { profile } from '../../data/profile';
const homeLink = (hash: string) => Astro.url.pathname === '/' ? hash : `/${hash}`;
const groups = [
  { title: 'This site', links: [{ label: 'Home', href: homeLink('#intro') }, { label: 'Work', href: homeLink('#projects') }, { label: 'Activity', href: homeLink('#contributions') }, { label: 'Guestbook', href: '/guestbook/' }] },
  { title: 'Resources', links: [{ label: 'Résumé', href: profile.resume }, { label: 'Source code', href: profile.source }] },
  { title: 'Connect', links: [{ label: 'Email', href: `mailto:${profile.email}` }, { label: 'GitHub', href: profile.github }, { label: 'LinkedIn', href: profile.linkedin }, { label: 'Credly', href: profile.credly }] },
];
---
<footer>
  <div class="footer-top">
    <div class="signature"><span>Portfolio</span><span class="metadata">Data, AI, cloud &amp; IoT.</span></div>
    <div class="listening" role="group" aria-label="Listening widget placeholder">
      <div class="album" aria-hidden="true"><span></span></div>
      <div><span class="metadata">On repeat</span><p>Track placeholder</p><span class="metadata">Artist placeholder</span></div>
    </div>
  </div>
  <div class="groups">
    {groups.map(group => <div><h2>{group.title}</h2><ul>{group.links.map(link => <li><PortfolioLink {...link} /></li>)}</ul></div>)}
  </div>
  <p class="footer-note">© 2026. Built with Astro.</p>
</footer>
<style>
  footer { border-top: 1px solid var(--color-border); padding-block: 40px 32px; }
  .footer-top { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; margin-bottom: 40px; }
  .signature { display: flex; flex-direction: column; gap: 2px; }
  .signature > span:first-child { font-weight: 600; }
  .listening { display: flex; align-items: center; gap: 12px; font-size: 15px; line-height: 1.35; }
  .listening .metadata { font-size: 13px; }
  .listening p { margin-block: 2px; }
  .album { display: grid; place-items: center; width: 52px; aspect-ratio: 1; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); }
  .album span { width: 28px; aspect-ratio: 1; border: 1px solid var(--color-border); border-radius: 50%; position: relative; }
  .album span::after { content: ''; position: absolute; inset: 10px; border: 1px solid var(--color-border); border-radius: 50%; }
  .groups { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 16px; }
  h2 { font-family: var(--font-sans); font-size: 14px; font-weight: 400; letter-spacing: 0; color: var(--color-muted); margin-bottom: 8px; }
  li { display: flex; align-items: center; min-height: 44px; }
  li :global(a) { text-decoration: none; }
  li :global(a:hover) { text-decoration: underline; }
  .footer-note { margin-top: 32px; font-size: 13px; color: var(--color-muted); }
  @media (max-width: 767px) {
    .footer-top { flex-direction: column; gap: 24px; margin-bottom: 32px; }
    .groups { font-size: 15px; gap: 12px; }
    footer { padding-top: 32px; }
  }
</style>
