---
import Icon from '../ui/Icon.astro';
const isHome = Astro.url.pathname === '/';
const homeLink = (hash: string) => isHome ? hash : `/${hash}`;
const links = [
  { label: 'Home', href: homeLink('#intro'), icon: 'home' as const },
  { label: 'Work', href: homeLink('#projects'), icon: 'work' as const },
  { label: 'Activity', href: homeLink('#contributions'), icon: 'activity' as const },
  { label: 'Guestbook', href: '/guestbook/', icon: 'guestbook' as const },
];
---
<header>
  <nav aria-label="Main navigation">
    <div class="destinations">
      {links.map(link => <a href={link.href} aria-label={link.label} title={link.label} aria-current={!isHome && link.label === 'Guestbook' ? 'page' : undefined}><Icon name={link.icon} /><span>{link.label}</span></a>)}
    </div>
    <div class="utilities"><a href={homeLink('#contact')} aria-label="Contact" title="Contact"><Icon name="contact" /></a></div>
  </nav>
</header>
<style>
  header { position: sticky; top: 16px; z-index: 20; margin-block: 16px 64px; }
  nav { display: flex; justify-content: space-between; align-items: center; padding: 4px 8px; min-height: 56px; border: 1px solid var(--color-border); border-radius: 22px; background: var(--color-nav); box-shadow: 0 2px 3px rgb(41 40 36 / 3%); }
  .destinations, .utilities { display: flex; align-items: center; }
  .utilities { border-left: 1px solid var(--color-border); padding-left: 8px; }
  a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 8px 12px; border-radius: 12px; color: var(--color-muted); font-size: 16px; font-weight: 600; text-decoration: none; }
  a:hover, a:focus-visible, a[aria-current='page'] { color: var(--color-text); background: var(--color-surface); }
  .destinations :global(svg) { display: none; }
  @media (max-width: 767px) {
    header { position: fixed; inset: auto var(--page-gutter) max(12px, env(safe-area-inset-bottom)); margin: 0; }
    nav { max-width: 480px; margin-inline: auto; border-radius: 20px; box-shadow: 0 4px 20px rgb(41 40 36 / 8%); }
    .destinations { flex: 1; justify-content: space-around; }
    .destinations :global(svg) { display: block; }
    .destinations span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .utilities { margin-left: 8px; }
    a { padding: 8px; }
  }
</style>
