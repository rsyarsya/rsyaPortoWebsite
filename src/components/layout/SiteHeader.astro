---
import Icon from '../ui/Icon.astro';
import NavPreferences from './NavPreferences.astro';
const isHome = Astro.url.pathname === '/';
const homeLink = (hash: string) => isHome ? hash : `/${hash}`;
const links = [
  { label: 'Home', href: homeLink('#intro'), icon: 'home' as const },
  { label: 'Work', href: homeLink('#projects'), icon: 'work' as const },
  { label: 'Activity', href: homeLink('#contributions'), icon: 'activity' as const },
  { label: 'Guestbook', href: '/guestbook/', icon: 'guestbook' as const },
];
---
<div class="header-space" aria-hidden="true"></div>
<header class="site-header" data-state="top">
  <nav aria-label="Main navigation">
    <div class="destinations">
      {links.map(link => <a href={link.href} aria-label={link.label} title={link.label} aria-current={(isHome && link.label === 'Home') || (!isHome && link.label === 'Guestbook') ? 'page' : undefined}><Icon name={link.icon} /><span>{link.label}</span></a>)}
    </div>
    <div class="utilities"><NavPreferences /></div>
  </nav>
</header>
<script>
  import '../../scripts/navigation';
</script>
<style>
  .header-space { height: 56px; margin-block: 16px 64px; }
  header { position: fixed; top: 16px; inset-inline: var(--page-gutter); width: min(var(--content-width), calc(100% - var(--page-gutter) * 2)); margin-inline: auto; z-index: 40; color: var(--color-muted); transition: transform 300ms ease-out, opacity 300ms ease-out; }
  nav { display: flex; justify-content: space-between; align-items: center; padding: 4px 8px; min-height: 56px; border: 1px solid var(--color-nav-border); border-radius: 22px; background: var(--color-nav-bg); backdrop-filter: blur(24px) saturate(150%); -webkit-backdrop-filter: blur(24px) saturate(150%); box-shadow: var(--shadow-nav); transition: background-color 300ms ease-out, border-color 300ms ease-out, box-shadow 300ms ease-out; }
  header[data-state='top'] nav { background: transparent; border-color: transparent; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
  header[data-state='top'] .utilities { border-color: transparent; }
  header[data-state='hidden'] { opacity: 0; transform: translateY(calc(-100% - 24px)); pointer-events: none; }
  header:has(:focus-visible) { opacity: 1; transform: none; pointer-events: auto; }
  .destinations, .utilities { display: flex; align-items: center; }
  .utilities { border-left: 1px solid var(--color-nav-border); padding-left: 8px; }
  a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 8px 12px; border-radius: 12px; color: var(--color-muted); font-size: 16px; font-weight: 600; text-decoration: none; }
  a:hover, a:focus-visible { color: var(--color-text); background: var(--color-surface); }
  a[aria-current] { color: var(--color-text); }
  .destinations :global(svg) { display: none; }
  @media (min-width: 768px) {
    header[data-state='top'] nav { padding-inline: 0; }
    header[data-state='top'] .destinations { margin-left: -12px; }
  }
  @media (max-width: 767px) {
    .header-space { display: none; }
    header { inset: auto var(--page-gutter) max(12px, env(safe-area-inset-bottom)); }
    header[data-state='top'] nav { background: var(--color-nav-bg); border-color: var(--color-nav-border); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }
    header[data-state='top'] .utilities { border-color: var(--color-nav-border); }
    header[data-state='hidden'] { transform: translateY(calc(100% + 24px + env(safe-area-inset-bottom))); }
    header:has(:focus-visible) { transform: none; }
    nav { max-width: 480px; margin-inline: auto; border-radius: 20px; box-shadow: var(--shadow-dock); }
    .destinations { flex: 1; justify-content: space-around; }
    .destinations :global(svg) { display: block; }
    .destinations span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .utilities { margin-left: 4px; padding-left: 4px; }
    a { padding: 6px; }
  }
  :global(html[data-motion='reduce']) header, :global(html[data-motion='reduce']) nav { transition: none; }
</style>
