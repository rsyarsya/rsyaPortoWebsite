---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Icon from '../components/ui/Icon.astro';
import ContactDialog from '../components/ui/ContactDialog.astro';
---
<BaseLayout title="Guestbook — Rasyadwa Arsya" description="A little space to leave a note, say hello, or share your website. Notes appear after approval.">
  <Container>
    <SiteHeader />
    <main id="main" tabindex="-1" class="guestbook-page">
      <div class="page-intro"><h1>Guestbook</h1><p>Leave a note, say hi, or share your website.</p></div>
      <section class="composer" aria-label="Sign the guestbook">
        <div class="composer-actions">
          <button type="button" class="anonymous requires-script" aria-expanded="false" aria-controls="anonymous-form"><Icon name="user" />Write anonymously</button>
          <button type="button" class="github-later" disabled aria-describedby="github-status"><Icon name="github" />GitHub sign-in (later)</button>
        </div>
        <p id="signing-status" class="requires-script">Name and website are optional. Notes appear here after approval.</p>
        <p id="github-status" class="note">GitHub sign-in is not available yet.</p>
        <noscript><p class="note">Reading and signing the guestbook needs JavaScript.</p></noscript>
        <form id="anonymous-form" method="post" action="/api/guestbook" novalidate hidden>
          <div class="form-fields">
            <div class="field"><label for="guest-name">Name <span>(optional)</span></label><input id="guest-name" name="name" type="text" autocomplete="name" spellcheck="false" placeholder="Your name" maxlength="80" /></div>
            <div class="field">
              <label for="guest-site">Website <span>(optional)</span></label>
              <input id="guest-site" name="website" type="url" inputmode="url" autocomplete="url" spellcheck="false" placeholder="https://your-website.com" maxlength="200" aria-invalid="false" aria-describedby="guest-site-error" />
              <p id="guest-site-error" class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for="guest-message">Message</label>
              <textarea id="guest-message" name="message" rows="4" placeholder="Say hello…" maxlength="1000" aria-required="true" aria-invalid="false" aria-describedby="guest-message-error guest-message-count" data-lenis-prevent></textarea>
              <div class="field-meta"><p id="guest-message-error" class="field-error" hidden></p><p id="guest-message-count" class="count">1,000 characters left</p></div>
            </div>
            <!-- Honeypot: hidden from people and assistive tech; bots that fill it are rejected. -->
            <div class="trap" aria-hidden="true"><label for="guest-trap">Leave this empty</label><input id="guest-trap" name="trap" type="text" tabindex="-1" autocomplete="off" /></div>
            <p id="form-error" class="form-error" hidden></p>
            <div class="form-actions"><button type="submit" class="submit">Sign guestbook</button><button type="button" class="cancel">Back</button></div>
          </div>
        </form>
        <!-- One polite announcer for validation and result messages; outside the hidden form so it is in the accessibility tree from load. -->
        <p id="form-announcer" class="visually-hidden" role="status"></p>
      </section>
      <section class="entries" aria-labelledby="entries-title" aria-busy="true">
        <div class="entries-heading"><h2 id="entries-title">Entries</h2></div>
        <ul class="entry-list" hidden></ul>
        <div class="entries-state requires-script" data-state="loading"><div class="avatar" aria-hidden="true"><Icon name="guestbook" /></div><div><p class="state-title">Loading notes…</p><p class="muted state-detail"></p><button type="button" class="retry" hidden>Try again</button></div></div>
        <button type="button" class="load-more" hidden>Load more</button>
        <template id="entry-template"><li class="entry"><div class="avatar" aria-hidden="true"><Icon name="user" /></div><div class="entry-body"><p class="entry-meta"><span class="entry-name"></span><time class="entry-date"></time></p><p class="entry-message"></p></div></li></template>
      </section>
    </main>
    <SiteFooter />
  </Container>
  <ContactDialog />
</BaseLayout>
<script>
  import { normalizeWebsite } from '../lib/website';

  type Entry = { id: string; name: string | null; website: string | null; message: string; created_at: string };

  const toggle = document.querySelector<HTMLButtonElement>('.anonymous');
  const form = document.querySelector<HTMLFormElement>('#anonymous-form');
  const actions = document.querySelector<HTMLElement>('.composer-actions');
  const cancel = document.querySelector<HTMLButtonElement>('.cancel');
  const submit = document.querySelector<HTMLButtonElement>('.submit');
  const status = document.querySelector<HTMLElement>('#signing-status');
  const githubStatus = document.querySelector<HTMLElement>('#github-status');
  const formError = document.querySelector<HTMLElement>('#form-error');
  const name = document.querySelector<HTMLInputElement>('#guest-name');
  const site = document.querySelector<HTMLInputElement>('#guest-site');
  const message = document.querySelector<HTMLTextAreaElement>('#guest-message');
  const trap = document.querySelector<HTMLInputElement>('#guest-trap');
  const count = document.querySelector<HTMLElement>('#guest-message-count');
  const announcer = document.querySelector<HTMLElement>('#form-announcer');
  let announceTimer = 0;
  let messageEdited = false;
  let countLevel = 0;
  let sending = false;

  function announce(text: string) {
    if (!announcer) return;
    clearTimeout(announceTimer);
    announcer.textContent = '';
    // The short gap makes a repeated message count as new; clearing later leaves no stale text for browse mode.
    announceTimer = window.setTimeout(() => {
      announcer.textContent = text;
      announceTimer = window.setTimeout(() => { announcer.textContent = ''; }, 7000);
    }, 100);
  }
  /** Shows or clears a field's error; returns true when the visible message changed. */
  function setError(field: HTMLInputElement | HTMLTextAreaElement, text: string) {
    const error = document.getElementById(`${field.id}-error`);
    if (!error || error.textContent === text) return false;
    error.textContent = text;
    error.hidden = !text;
    field.setAttribute('aria-invalid', String(Boolean(text)));
    return true;
  }
  function siteError(value: string) {
    return !value.trim() || normalizeWebsite(value) ? '' : 'Enter a web address, like example.com.';
  }
  function messageError(value: string) {
    if (!value.trim()) return 'Enter a message.';
    return value.length > 1000 ? 'Use 1,000 characters or fewer.' : '';
  }
  function validate(field: HTMLInputElement | HTMLTextAreaElement, check: (value: string) => string) {
    // Leaving the form (Back, Escape) blurs the field after the panel is hidden: no error then.
    if (form?.hidden) return;
    const text = check(field.value);
    if (setError(field, text) && text) announce(text);
  }
  function updateCount(speak = true) {
    if (!message || !count || message.maxLength < 0) return;
    const left = Math.max(0, message.maxLength - message.value.length);
    const text = left === 0 ? 'No characters left' : `${left.toLocaleString('en-US')} ${left === 1 ? 'character' : 'characters'} left`;
    count.textContent = text;
    // Announce at two thresholds only (100 left, none left), not on every keystroke.
    const level = left === 0 ? 2 : left <= 100 ? 1 : 0;
    if (speak && level > countLevel) announce(text);
    countLevel = level;
  }
  function setFormError(text: string) {
    if (!formError) return;
    formError.textContent = text;
    formError.hidden = !text;
    if (text) announce(text);
  }
  function setOpen(open: boolean) {
    if (!form || !actions || !toggle) return;
    form.hidden = !open;
    actions.hidden = open;
    if (status) status.hidden = open;
    if (githubStatus) githubStatus.hidden = open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      // On back/forward the browser restores typed text after this script runs, without an input event.
      updateCount(false);
      name?.focus();
      return;
    }
    clearTimeout(announceTimer);
    if (announcer) announcer.textContent = '';
    toggle.focus();
  }
  /** The store is not configured on this host: say so instead of offering a form that cannot save. */
  function markUnavailable() {
    if (toggle) toggle.hidden = true;
    if (status) { status.hidden = false; status.textContent = 'Signing is unavailable right now. Please check back later.'; }
  }

  function setSending(value: boolean) {
    sending = value;
    if (!submit) return;
    submit.disabled = value;
    submit.textContent = value ? 'Signing…' : 'Sign guestbook';
    form?.setAttribute('aria-busy', String(value));
  }

  async function send(event: SubmitEvent) {
    event.preventDefault();
    if (!form || !name || !site || !message || sending) return;
    setFormError('');
    const siteText = siteError(site.value);
    const messageText = messageError(message.value);
    setError(site, siteText);
    setError(message, messageText);
    if (siteText || messageText) {
      (siteText ? site : message).focus();
      announce(siteText || messageText);
      return;
    }

    setSending(true);
    let response: Response | null = null;
    let data: { code?: string; errors?: Record<string, string> } = {};
    try {
      response = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ name: name.value, website: site.value, message: message.value, trap: trap?.value ?? '' }),
      });
      data = await response.json().catch(() => ({}));
    } catch { /* Network failure: handled below with the input kept. */ }
    setSending(false);

    if (response?.status === 202) {
      form.reset();
      messageEdited = false;
      countLevel = 0;
      updateCount(false);
      setOpen(false);
      if (status) status.textContent = 'Thanks! Your note was saved and is waiting for approval. It will appear here once it has been reviewed.';
      announce(status?.textContent ?? '');
      return;
    }
    // Every failure keeps what the visitor typed.
    if (response?.status === 422 && data.code === 'invalid' && data.errors) {
      const fields = { name, website: site, message } as const;
      let first: HTMLInputElement | HTMLTextAreaElement | null = null;
      for (const [key, field] of Object.entries(fields)) {
        const text = data.errors[key] ?? '';
        setError(field, text);
        if (text && !first) first = field;
      }
      first?.focus();
      setFormError('Please fix the highlighted field.');
    } else if (response?.status === 503 && data.code === 'not_configured') {
      setFormError('Signing is unavailable right now, so your note was not saved. Please try again later.');
    } else if (response?.status === 429) {
      const minutes = Math.max(1, Math.ceil(Number(response.headers.get('Retry-After') ?? 60) / 60));
      setFormError(`You have signed a few times already. Please try again in ${minutes} ${minutes === 1 ? 'minute' : 'minutes'}.`);
    } else {
      setFormError('Something went wrong and your note was not saved. Please try again.');
    }
  }

  toggle?.addEventListener('click', () => setOpen(true));
  cancel?.addEventListener('click', () => setOpen(false));
  form?.addEventListener('submit', send);
  // Escape leaves the form like Back, except while an input method is composing text.
  form?.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !event.isComposing) setOpen(false);
  });
  // Errors appear when a field is left and clear as soon as the value is fixed.
  site?.addEventListener('blur', () => validate(site, siteError));
  site?.addEventListener('input', () => {
    if (site.getAttribute('aria-invalid') === 'true') setError(site, siteError(site.value));
  });
  message?.addEventListener('input', () => {
    messageEdited = true;
    updateCount();
    if (message.getAttribute('aria-invalid') === 'true') setError(message, messageError(message.value));
  });
  // Tabbing through an untouched message is not an error; clearing a typed one is.
  message?.addEventListener('blur', () => { if (messageEdited) validate(message, messageError); });

  // Entries: approved notes only, 20 per page, rendered with textContent (never as HTML).
  const section = document.querySelector<HTMLElement>('.entries');
  const list = document.querySelector<HTMLUListElement>('.entry-list');
  const state = document.querySelector<HTMLElement>('.entries-state');
  const stateTitle = state?.querySelector<HTMLElement>('.state-title');
  const stateDetail = state?.querySelector<HTMLElement>('.state-detail');
  const retry = state?.querySelector<HTMLButtonElement>('.retry');
  const loadMore = document.querySelector<HTMLButtonElement>('.load-more');
  const template = document.querySelector<HTMLTemplateElement>('#entry-template');
  const dateFormat = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  let cursor: string | null = null;

  function showState(kind: 'loading' | 'empty' | 'error' | 'unavailable' | null) {
    if (!state || !stateTitle || !stateDetail || !retry) return;
    state.hidden = kind === null;
    if (!kind) return;
    state.dataset.state = kind;
    const copy = {
      loading: ['Loading notes…', ''],
      empty: ['No notes yet.', 'Be the first to leave one.'],
      error: ['Notes could not load.', 'Check your connection and try again.'],
      unavailable: ['Notes are unavailable right now.', 'Please check back later.'],
    }[kind];
    stateTitle.textContent = copy[0];
    stateDetail.textContent = copy[1];
    stateDetail.hidden = !copy[1];
    retry.hidden = kind !== 'error';
  }

  function renderEntry(entry: Entry) {
    const item = template?.content.firstElementChild?.cloneNode(true) as HTMLLIElement | undefined;
    if (!item) return null;
    const nameEl = item.querySelector<HTMLElement>('.entry-name')!;
    const href = entry.website ? normalizeWebsite(entry.website) : null;
    const label = entry.name?.trim() || 'Anonymous';
    if (href) {
      const link = document.createElement('a');
      link.href = href;
      link.rel = 'ugc nofollow noopener noreferrer';
      link.target = '_blank';
      link.textContent = label;
      link.title = new URL(href).host;
      nameEl.append(link);
    } else {
      nameEl.textContent = label;
    }
    const date = item.querySelector<HTMLTimeElement>('.entry-date')!;
    const created = new Date(entry.created_at);
    if (!Number.isNaN(created.getTime())) {
      date.dateTime = entry.created_at;
      date.textContent = dateFormat.format(created);
    }
    item.querySelector<HTMLElement>('.entry-message')!.textContent = entry.message;
    return item;
  }

  async function loadEntries() {
    if (!list || !loadMore) return;
    const first = cursor === null;
    if (first) showState('loading');
    loadMore.disabled = true;
    loadMore.textContent = 'Loading…';
    section?.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch(`/api/guestbook${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ''}`, { headers: { Accept: 'application/json' } });
      const data = await response.json().catch(() => ({})) as { code?: string; entries?: Entry[]; nextCursor?: string | null };
      if (response.status === 503 && data.code === 'not_configured') {
        showState('unavailable');
        markUnavailable();
        loadMore.hidden = true;
        return;
      }
      if (!response.ok || !Array.isArray(data.entries)) throw new Error('bad response');
      for (const entry of data.entries) {
        const item = renderEntry(entry);
        if (item) list.append(item);
      }
      list.hidden = list.childElementCount === 0;
      showState(list.childElementCount === 0 ? 'empty' : null);
      cursor = data.nextCursor ?? null;
      loadMore.hidden = !cursor;
      loadMore.textContent = 'Load more';
    } catch {
      if (first) {
        showState('error');
        loadMore.hidden = true;
      } else {
        loadMore.textContent = 'Could not load more. Try again';
      }
    } finally {
      loadMore.disabled = false;
      section?.setAttribute('aria-busy', 'false');
    }
  }

  retry?.addEventListener('click', () => { cursor = null; void loadEntries(); });
  loadMore?.addEventListener('click', () => { void loadEntries(); });
  void loadEntries();
</script>
<style>
  .guestbook-page { padding-bottom: var(--section-gap); }
  .page-intro h1 { font-size: 36px; margin-bottom: 16px; }
  .page-intro p { color: var(--color-muted); }
  .composer { margin-top: 32px; border-radius: var(--radius-panel); background: var(--color-surface); padding: 20px; }
  .composer-actions, .form-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  [hidden] { display: none !important; }
  button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; font: 600 15px/1.4 var(--font-sans); min-height: 44px; border: 1px solid var(--color-border); border-radius: 12px; padding: 8px 14px; color: var(--color-text); background: var(--color-bg); cursor: pointer; }
  button:disabled { cursor: not-allowed; background: var(--color-disabled-bg); color: var(--color-disabled-fg); border-color: var(--color-disabled-border); }
  .submit { background: var(--color-btn-primary-bg); color: var(--color-btn-primary-fg); border-color: transparent; }
  .submit:hover:not(:disabled) { background: var(--color-btn-primary-hover-bg); }
  .anonymous:hover, .cancel:hover, .retry:hover, .load-more:hover:not(:disabled) { border-color: var(--color-border-interactive); }
  #signing-status, .note { font-size: 13px; color: var(--color-text-muted); }
  #signing-status { margin-top: 12px; }
  .note { margin-top: 4px; }
  /* The actions row is hidden while the form is open, so the fields start at the panel padding. */
  .form-fields { display: grid; gap: 20px; }
  .field { display: grid; gap: 6px; }
  label { font-size: 15px; font-weight: 600; }
  label span { color: var(--color-text-muted); font-size: 13px; font-weight: 400; }
  input, textarea { width: 100%; min-height: 44px; border: 1px solid var(--color-border-interactive); border-radius: 8px; padding: 10px 12px; background: var(--color-bg); color: var(--color-text); font: 16px/1.5 var(--font-sans); }
  textarea { resize: vertical; }
  /* Lenis skips this field (data-lenis-prevent) and lenis.css contains its overscroll; let the wheel continue to the page when it is empty or at its end. */
  #guest-message { overscroll-behavior: auto; }
  /* Validation: the error text under the field carries the meaning; the border color only repeats it. */
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: var(--color-error); }
  .field-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }
  .field-error, .form-error { font-size: 14px; color: var(--color-error); }
  .count { margin-left: auto; font-size: 13px; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Without scripts nothing can load or post, so script-only controls and states are not offered. */
  @media (scripting: none) { .requires-script { display: none; } }
  .entries { margin-top: 40px; }
  .entries-heading { padding-bottom: 12px; color: var(--color-muted); }
  .entries-heading h2 { font: 400 15px/1.5 var(--font-sans); letter-spacing: 0; }
  .entry-list { border-top: 1px solid var(--color-border); }
  .entry, .entries-state { display: flex; gap: 12px; border-bottom: 1px solid var(--color-border); padding-block: 24px; font-size: 15px; }
  .entries-state { border-top: 1px solid var(--color-border); }
  .entry-list:not([hidden]) + .entries-state { border-top: 0; }
  .entries-state .muted { margin-top: 4px; }
  .entries-state .retry { margin-top: 12px; }
  .entry-body { min-width: 0; flex: 1; }
  .entry-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }
  .entry-name { font-weight: 600; overflow-wrap: anywhere; }
  .entry-date { font-size: 13px; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .entry-message { margin-top: 4px; white-space: pre-line; overflow-wrap: anywhere; }
  .load-more { margin-top: 20px; }
  .avatar { display: grid; place-items: center; flex: 0 0 36px; height: 36px; border-radius: 50%; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted); }
  @media (max-width: 767px) { .guestbook-page { padding-top: 48px; } .page-intro h1 { font-size: 32px; } }
  @media (max-width: 400px) { .composer { padding: 16px; } .composer-actions { flex-direction: column; align-items: stretch; } }
</style>
