---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ContactDialog from '../components/ui/ContactDialog.astro';

const controls = [
  { id: 'pg-speed', param: 'speed', label: 'Wave speed', min: 0, max: 3, step: 0.1, value: 1, text: '1.0×' },
  { id: 'pg-height', param: 'height', label: 'Wave height', min: 0, max: 2, step: 0.1, value: 1, text: '1.0×' },
  { id: 'pg-strength', param: 'strength', label: 'Ripple strength', min: 0.1, max: 1.5, step: 0.1, value: 0.8, text: '0.8' },
  { id: 'pg-fade', param: 'fade', label: 'Ripple fade', min: 1, max: 8, step: 0.5, value: 3, text: '3.0 s' },
  { id: 'pg-density', param: 'density', label: 'Line density', min: 12, max: 48, step: 2, value: 24, text: '24 lines' },
];
---
<BaseLayout title="Playground — Rasyadwa Arsya" description="A small interactive experiment: stylised water lines you can adjust and ripple.">
  <Container>
    <SiteHeader />
    <main id="main" tabindex="-1" class="playground-page">
      <div class="page-intro">
        <h1>Playground</h1>
        <p>A small visual experiment with stylised waves. Adjust the sliders, then click or tap the water to add a ripple. The motion is drawn from simple sine curves; it is not a physics simulation.</p>
      </div>
      <section class="experiment" aria-labelledby="experiment-title" data-pg-panel>
        <h2 id="experiment-title" class="visually-hidden">Water lines</h2>
        <!-- The CSS background is the still frame without JS or canvas. -->
        <div class="stage" data-pg-stage role="img" aria-label="Wavy horizontal lines on a water-colored surface"><canvas></canvas></div>
        <noscript><p class="note">The experiment needs JavaScript. Without it you see a still picture.</p></noscript>
        <div class="controls requires-script">
          <div class="actions">
            <button type="button" class="button button-primary" data-pg-toggle>Pause</button>
            <button type="button" class="button button-secondary" data-pg-drop>Add ripple</button>
            <button type="button" class="button button-secondary" data-pg-reset>Reset</button>
            <p class="note" data-pg-status role="status"></p>
          </div>
          <div class="sliders">
            {controls.map(control => (
              <div class="slider">
                <div class="slider-label"><label for={control.id}>{control.label}</label><output for={control.id}>{control.text}</output></div>
                <input id={control.id} type="range" data-param={control.param} min={control.min} max={control.max} step={control.step} value={control.value} />
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </Container>
  <ContactDialog />
</BaseLayout>
<script>
  import '../scripts/playground-water';
</script>
<style>
  .playground-page { padding-bottom: var(--section-gap); }
  .page-intro h1 { font-size: 36px; margin-bottom: 16px; }
  .page-intro p { color: var(--color-muted); max-width: 65ch; }
  .experiment { margin-top: 32px; border-radius: var(--radius-panel); background: var(--color-surface); overflow: hidden; }
  /* aspect-ratio reserves the box before any script runs, so the canvas never shifts layout. */
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-border);
    background:
      repeating-linear-gradient(to bottom, transparent 0 15px, var(--scene-line-still) 15px 16px),
      linear-gradient(to bottom, var(--scene-bg-top), var(--scene-bg-bottom));
  }
  .stage canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; opacity: 0; cursor: crosshair; }
  .stage[data-ready] canvas { opacity: 1; }
  .controls { padding: 20px; display: grid; gap: 20px; }
  .sliders { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px 24px; }
  .slider { display: grid; gap: 6px; }
  .slider-label { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  label { font-size: 15px; font-weight: 600; }
  output { font-size: 14px; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  input[type='range'] { width: 100%; min-height: 44px; margin: 0; accent-color: var(--color-accent); cursor: pointer; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .actions .note { flex: 1 1 200px; margin-left: 4px; }
  .actions .button { cursor: pointer; font-family: var(--font-sans); line-height: inherit; color: var(--color-text); }
  .actions .button-primary { min-width: 88px; color: var(--color-btn-primary-fg); }
  .note { font-size: 13px; color: var(--color-text-muted); }
  .experiment > noscript .note { padding: 16px 20px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Without scripts the controls would do nothing, so they are not offered. */
  @media (scripting: none) { .requires-script { display: none; } }
  @media (max-width: 767px) { .playground-page { padding-top: 48px; } .page-intro h1 { font-size: 32px; } }
  @media (max-width: 400px) { .controls { padding: 16px; } }
</style>
